{
	"name": "DF_Select_Customer_Columns",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_sql_saleslt_customer",
						"type": "DatasetReference"
					},
					"name": "CustomerSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_blob_saleslt_sales_csv",
						"type": "DatasetReference"
					},
					"name": "BlobSink"
				}
			],
			"transformations": [
				{
					"name": "SelectCustomerColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          EmailAddress as string,",
				"          Phone as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> CustomerSource",
				"CustomerSource select(mapColumn(",
				"          CustomerID,",
				"          FirstName,",
				"          LastName,",
				"          EmailAddress",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectCustomerColumns",
				"SelectCustomerColumns sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['selected_customer_columns.csv']) ~> BlobSink"
			]
		}
	}
}