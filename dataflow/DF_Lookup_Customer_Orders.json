{
	"name": "DF_Lookup_Customer_Orders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_sql_saleslt_customer",
						"type": "DatasetReference"
					},
					"name": "CustomerSource"
				},
				{
					"dataset": {
						"referenceName": "ds_sql_saleslt_salesorder",
						"type": "DatasetReference"
					},
					"name": "SalesOrderSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_blob_Datasets_Sample_ds_blob_Datasets_Sample",
						"type": "DatasetReference"
					},
					"name": "BlobSink"
				}
			],
			"transformations": [
				{
					"name": "LookupCustomerOrders"
				},
				{
					"name": "SelectFinalColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          EmailAddress as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> CustomerSource",
				"source(output(",
				"          SalesOrderID as integer,",
				"          CustomerID as integer,",
				"          OrderDate as timestamp,",
				"          TotalDue as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SalesOrderSource",
				"SalesOrderSource, CustomerSource lookup(SalesOrderSource@CustomerID == CustomerSource@CustomerID,",
				"     multiple: false,",
				"     pickup: 'first',",
				"     broadcast: 'auto')~> LookupCustomerOrders",
				"LookupCustomerOrders select(mapColumn(",
				"          CustomerID = SalesOrderSource@CustomerID,",
				"          SalesOrderID,",
				"          OrderDate,",
				"          TotalDue,",
				"          FirstName,",
				"          LastName,",
				"          EmailAddress",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectFinalColumns",
				"SelectFinalColumns sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['lookup_customer_orders.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> BlobSink"
			]
		}
	}
}