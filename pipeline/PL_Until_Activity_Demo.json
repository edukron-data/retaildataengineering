{
	"name": "PL_Until_Activity_Demo",
	"properties": {
		"activities": [
			{
				"name": "Set_Initial_Status",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Status",
					"value": "RUNNING"
				}
			},
			{
				"name": "Until_Status_Success",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Set_Initial_Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('Status'),'SUCCESS')",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Lookup_API_Status",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlSource",
									"sqlReaderQuery": "SELECT 'SUCCESS' AS Status",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_sql_dynamic",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Set_Status_Variable",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Lookup_API_Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Status",
								"value": {
									"value": "@activity('Lookup_API_Status').output.firstRow.Status",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Wait_10_Seconds",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Set_Status_Variable",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 10
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "Copy_Final_Data_To_Blob",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Until_Status_Success",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": "SELECT TOP 100 * FROM SalesLT.Customer",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_sql_dynamic",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_blob_dynamic",
						"type": "DatasetReference"
					}
				]
			}
		],
		"variables": {
			"Status": {
				"type": "String"
			}
		},
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}