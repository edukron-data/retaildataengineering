{
	"name": "PL_Continuous_API_To_SQL",
	"properties": {
		"activities": [
			{
				"name": "Until_Activity",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(1,2)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_API_To_SQL",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET"
								},
								"sink": {
									"type": "SqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "$['id']"
											},
											"sink": {
												"name": "product_id",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['title']"
											},
											"sink": {
												"name": "product_title",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['price']"
											},
											"sink": {
												"name": "price",
												"type": "Double"
											}
										},
										{
											"source": {
												"path": "$['brand']"
											},
											"sink": {
												"name": "brand",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['category']"
											},
											"sink": {
												"name": "category",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['rating']"
											},
											"sink": {
												"name": "rating",
												"type": "Double"
											}
										}
									],
									"collectionReference": "$['products']"
								}
							},
							"inputs": [
								{
									"referenceName": "ds_rest_products",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_sql_products",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "Wait_5_Minutes",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Copy_API_To_SQL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 300
							}
						}
					],
					"timeout": "1.00:00:00"
				}
			}
		],
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}