{
	"name": "PL_Filter_Activity_Demo",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Sales_Data",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": "SELECT CustomerID, TotalDue FROM SalesLT.SalesOrderHeader",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_dynamic",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Filter_High_Sales",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Lookup_Sales_Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Sales_Data').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@greater(item().TotalDue,5000)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach_Filtered_Records",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter_High_Sales",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter_High_Sales').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy_Filtered_Data_To_Blob",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT * FROM SalesLT.SalesOrderHeader WHERE CustomerID = ',string(item().CustomerID))",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_sql_dynamic",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_blob_dynamic",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}