	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Customer_Name_Cleanup')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_saleslt_customer",
								"type": "DatasetReference"
							},
							"name": "CustomerSource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_blob_saleslt_sales_csv",
								"type": "DatasetReference"
							},
							"name": "BlobSink"
						}
					],
					"transformations": [
						{
							"name": "CleanCustomerName"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as integer,",
						"          FirstName as string,",
						"          LastName as string,",
						"          EmailAddress as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> CustomerSource",
						"CustomerSource derive(FirstName = trim(initCap(FirstName)),",
						"          LastName = trim(initCap(LastName)),",
						"          EmailAddress = lower(trim(EmailAddress))) ~> CleanCustomerName",
						"CleanCustomerName sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['clean_customer_names.csv']) ~> BlobSink"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Derived_Column_Customer')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_saleslt_customer",
