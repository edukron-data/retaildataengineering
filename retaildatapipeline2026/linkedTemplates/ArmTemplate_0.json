							"name": "BlobSink"
						}
					],
					"transformations": [
						{
							"name": "DerivedCustomerColumns"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as integer,",
						"          FirstName as string,",
						"          LastName as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> CustomerSource",
						"CustomerSource derive(FullName = FirstName + ' ' + LastName,",
						"          LoadDate = currentDate()) ~> DerivedCustomerColumns",
						"DerivedCustomerColumns sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['customer_fullname.csv']) ~> BlobSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_saleslt_customer')]",
				"[concat(variables('factoryId'), '/datasets/ds_blob_saleslt_sales_csv')]"
			]
		}
	]
}