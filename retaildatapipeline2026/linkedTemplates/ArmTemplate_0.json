		{
			"name": "[concat(parameters('factoryName'), '/PL_REST_API_To_Blob_Products')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy_REST_API_To_Blob",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 3,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "RestSource",
								"httpRequestTimeout": "00:01:40",
								"requestInterval": "00.00:00:00.010",
								"requestMethod": "GET",
								"paginationRules": {
									"AbsoluteUrl": "$.next"
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings",
									"copyBehavior": "FlattenHierarchy"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_rest_api",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_blob_dynamic",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [
					"REST API to Blob Pipeline",
					"Retail Product Ingestion"
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_rest_api')]",
				"[concat(variables('factoryId'), '/datasets/ds_blob_dynamic')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Aggregate_Customer_Sales')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_saleslt_salesorder",
								"type": "DatasetReference"
							},
							"name": "SalesOrderSource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_blob_saleslt_sales_csv",
								"type": "DatasetReference"
							},
							"name": "BlobSink"
						}
					],
					"transformations": [
						{
							"name": "AggregateCustomerSales"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as integer,",
						"          TotalDue as decimal(18,2)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SalesOrderSource",
						"SalesOrderSource aggregate(groupBy(CustomerID),",
						"     TotalSales = sum(TotalDue),",
						"          OrderCount = count(CustomerID)) ~> AggregateCustomerSales",
						"AggregateCustomerSales sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['customer_aggregate.csv']) ~> BlobSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_saleslt_salesorder')]",
				"[concat(variables('factoryId'), '/datasets/ds_blob_saleslt_sales_csv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Conditional_Split_Orders')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_saleslt_salesorder",
								"type": "DatasetReference"
							},
							"name": "SalesOrderSource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_blob_saleslt_sales_csv",
								"type": "DatasetReference"
							},
							"name": "HighValueSink"
						},
						{
							"dataset": {
								"referenceName": "ds_blob_saleslt_sales_csv",
								"type": "DatasetReference"
							},
							"name": "MediumValueSink"
						},
						{
							"dataset": {
								"referenceName": "ds_blob_saleslt_sales_csv",
								"type": "DatasetReference"
							},
							"name": "LowValueSink"
						}
					],
					"transformations": [
						{
							"name": "ConditionalSplitOrders"
						}
					],
					"scriptLines": [
						"source(output(",
						"          SalesOrderID as integer,",
						"          CustomerID as integer,",
						"          OrderDate as timestamp,",
						"          TotalDue as decimal(18,2)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SalesOrderSource",
						"SalesOrderSource split(TotalDue >= 10000,",
						"     TotalDue >= 5000 && TotalDue < 10000,",
						"     disjoint: true) ~> ConditionalSplitOrders@(HighValue, MediumValue, LowValue)",
						"ConditionalSplitOrders@HighValue sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['high_value.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> HighValueSink",
						"ConditionalSplitOrders@MediumValue sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['medium_value.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> MediumValueSink",
						"ConditionalSplitOrders@LowValue sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['low_value.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> LowValueSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_saleslt_salesorder')]",
				"[concat(variables('factoryId'), '/datasets/ds_blob_saleslt_sales_csv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Customer_Name_Cleanup')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_saleslt_customer",
								"type": "DatasetReference"
							},
							"name": "CustomerSource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_blob_saleslt_sales_csv",
								"type": "DatasetReference"
							},
							"name": "BlobSink"
						}
					],
					"transformations": [
						{
							"name": "CleanCustomerName"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as integer,",
						"          FirstName as string,",
						"          LastName as string,",
						"          EmailAddress as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> CustomerSource",
						"CustomerSource derive(FirstName = trim(initCap(FirstName)),",
						"          LastName = trim(initCap(LastName)),",
						"          EmailAddress = lower(trim(EmailAddress))) ~> CleanCustomerName",
						"CleanCustomerName sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['clean_customer_names.csv']) ~> BlobSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_saleslt_customer')]",
				"[concat(variables('factoryId'), '/datasets/ds_blob_saleslt_sales_csv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Derived_Column_Customer')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_saleslt_customer",
								"type": "DatasetReference"
							},
							"name": "CustomerSource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_blob_saleslt_sales_csv",
								"type": "DatasetReference"
